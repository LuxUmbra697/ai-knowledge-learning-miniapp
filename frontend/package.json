{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "LuxUmbra-AI闯关学习小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "@dagrejs/dagre": "1.1.8",
    "@tarojs/components": "4.1.11",
    "@tarojs/helper": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/react": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "dompurify": "3.4.15",
    "mermaid": "11.17.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.21.5",
    "@playwright/test": "^1.63.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "4.1.11",
    "@tarojs/webpack5-runner": "4.1.11",
    "@types/react": "^18.0.0",
    "babel-preset-taro": "4.1.11",
    "lucide-static": "^1.44.0",
    "miniprogram-automator": "^0.12.1",
    "react-refresh": "0.14.2",
    "sass": "^1.80.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.1.0",
    "webpack": "5.91.0",
    "webpack-cli": "5.1.4"
  }
}
