.git
.gitignore
.vscode

# Python 运行产物
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Never bundle runtime data; production mounts a separate persistent directory.
data/

# 测试与文档
tests/
sql/
scripts/
*.md
