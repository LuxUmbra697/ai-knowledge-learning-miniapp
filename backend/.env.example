# LuxUmbra-AI闯关学习小程序 - 后端环境变量示例
# 复制本文件为 .env 后，按实际环境填写配置值

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily 联网搜索配置（用于 AI 出题时获取最新知识）
TAVILY_API_KEY=your_tavily_api_key
ENABLE_WEB_SEARCH=true

# DashScope（百炼 Embedding，用于知识库 RAG）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 知识库 / 向量存储配置
CHROMA_PERSIST_DIR=./data/chroma
KB_UPLOAD_DIR=./data/uploads
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4

# 题目配图：独立配置生图 Key，不回退或复用 Embedding Key。
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=
IMAGE_GEN_SIZE=512*512
IMAGE_GEN_DAILY_LIMIT=20
IMAGE_GEN_MAX_CONCURRENCY=5

# 腾讯云 COS（存储 AI 生成的题目配图）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-shanghai
COS_BUCKET=your_bucket-appid
COS_UPLOAD_PREFIX=quiz-images/
COS_DOMAIN=

# 后端服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_ENV=development
JWT_SECRET=
JWT_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://127.0.0.1:18082,http://localhost:18082
# Production must explicitly use REQUIRE_PAID_MODELS=true for this deployment.
REQUIRE_PAID_MODELS=false
# Optional absolute directory inside the runtime container; empty for API-only local development.
H5_STATIC_DIR=

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=luxumbra_ai_learn
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
# Startup never creates tables; run the explicit migration command.
MYSQL_AUTO_INIT=false

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
# release requires a published login page; trial/develop are restricted by WeChat membership.
WECHAT_QR_ENV=release

# 日志级别；生产 Compose 固定为 WARNING，保留警告与错误。
# DEBUG / INFO / WARNING / ERROR / CRITICAL；不写请求正文、凭据或模型原始响应。
LOG_LEVEL=INFO

# Bounded document parsing; OCR is not enabled.
KB_MAX_PDF_PAGES=120
KB_MAX_TEXT_CHARS=500000
KB_PARSE_TIMEOUT_SECONDS=25
KB_MAX_UNCOMPRESSED_MB=20
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=15
KB_RETRIEVE_CANDIDATES=20
# none or lexical (bounded rule-based reranker, no resident neural model)
KB_RERANKER=lexical
KB_MAX_CORPUS_CHUNKS=10000
# One embedded worker in the single API process; queue/checkpoints are persisted in MySQL.
WORKER_ENABLED=false
WORKER_DAILY_PROVIDER_CALLS=100
WORKER_DAILY_PROVIDER_INPUT_BYTES=500000
